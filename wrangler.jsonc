{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaodownpoki-web",
  "main": "./src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./"
  },

  // Settings that are safe to keep in code. These are re-applied on every deploy.
  // Testing: SQUARE_ENVIRONMENT "sandbox" with the sandbox location ID (LYAR7RYESXPHA).
  "vars": {
    "SQUARE_ENVIRONMENT": "production",
    "SQUARE_LOCATION_ID": "LYNQCZPJY9BPS",
    // Cloudflare Turnstile site key (public). The check turns on once this and the
    // TURNSTILE_SECRET_KEY secret are both set.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFRFndYrPi2tQQ67"
  },

  // Order attempts allowed per IP address: 5 a minute
  "ratelimits": [
    { "name": "ORDER_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]

  // SQUARE_ACCESS_TOKEN and TURNSTILE_SECRET_KEY are secrets: never put them in this
  // file. Add them in the Cloudflare dashboard → Worker → Settings → Variables and
  // Secrets, type "Secret". Secrets are kept across deploys.
}
