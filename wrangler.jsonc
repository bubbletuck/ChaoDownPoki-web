{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaodownpoki-web",
  "main": "./src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./"
  },

  // Settings that are safe to keep in code. These are re-applied on every deploy.
  // Testing: SQUARE_ENVIRONMENT "sandbox" with the sandbox location ID (LYAR7RYESXPHA).
  "vars": {
    "SQUARE_ENVIRONMENT": "production",
    "SQUARE_LOCATION_ID": "LYNQCZPJY9BPS"
  }

  // SQUARE_ACCESS_TOKEN is a secret: never put it in this file. Add it in the
  // Cloudflare dashboard → Worker → Settings → Variables and Secrets, type "Secret".
  // Secrets are kept across deploys.
}
