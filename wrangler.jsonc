{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaodownpoki-web",
  "main": "./src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./"
  },

  // Settings that are safe to keep in code. These are re-applied on every deploy.
  // Going live: change SQUARE_ENVIRONMENT to "production" and use your production location ID.
  "vars": {
    "SQUARE_ENVIRONMENT": "sandbox",
    "SQUARE_LOCATION_ID": "LYAR7RYESXPHA"
  }

  // SQUARE_ACCESS_TOKEN is a secret: never put it in this file. Add it in the
  // Cloudflare dashboard → Worker → Settings → Variables and Secrets, type "Secret".
  // Secrets are kept across deploys.
}
